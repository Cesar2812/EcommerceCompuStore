@{
    ViewBag.Title = "Dashboard";
}

<!--TITULO DE LA SECCION DE INFORMACION-->
<div class="card-header fs-4 mt-2">
    <i class="fas fa-store-alt me-1 fa-1x"></i> INFORMEMES DE LA TIENDA
</div>

<!--Muestra las secciones para devolver entre-->
<ol class="breadcrumb mb-4 mt-2">
    <li class="breadcrumb-item"><a href="@Url.Action("Categorias","Catalogos")">Categorias</a></li>
    <li class="breadcrumb-item active">Dashboard</li>
</ol>

<!--Muestra los cards-->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: rgb(148, 112, 219);">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total De Clientes</h6>
                        <h6 id="totalClientes">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: rgb(112, 224, 224);">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total De Ventas</h6>
                        <h6 id="totalVentas">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-shopping-bag fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: rgb(113, 195, 160);">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Total De Productos</h6>
                        <h6 id="totalProductos">0</h6>
                    </div>
                    <div class="col-sm-3">
                        <i class="fas fa-boxes fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card text-white mb-4" style="background-color: rgb(70, 100, 120);">
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-9">
                        <h6>Ganancias Totales</h6>
                        <h6 id="gananciasTotales">0.00</h6>
                    </div>
                    <div class="col-sm-3">
                        <i style="font-size: 1.5rem; font-style: normal;">C$</i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!--Muestra el CARD de la tabla-->
<div class="card mb-4">

    <div class="card-header">
        <i class="fas fa-tags me-1"></i>
        HISTORIAL DE VENTAS
    </div>


    <div class="card-body">

        <form action="@Url.Action("ExportarVentas","Home")" method="post">
            <div class="row align-items-end">

                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Fecha De Inicio</label>
                        <input class="form-control" type="text" id="txtFechainicio" name="fechainicio" />
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">Fecha Final</label>
                        <input class="form-control" type="text" id="txtFechaFin" name="fechafin" />
                    </div>
                </div>

                <div class="col-sm-2">
                    <div class="mb-2">
                        <label class="form-label">N° De Transacción</label>
                        <input class="form-control" type="text" id="txtTransaccion" name="transaccion" autocomplete="off" />
                    </div>
                </div>


                <div class="col-sm-2">
                    <div class="d-grid mb-2">
                        <button class="btn btn-primary" id="btnBuscar" type="button"><i class="fas fa-search"></i> Buscar </button>
                    </div>
                </div>


                <div class="col-sm-2">
                    <div class="d-grid mb-2">
                        <button class="btn btn-success" type="submit"><i class="fas fa-file-excel"></i> Exportar </button>
                    </div>
                </div>

            </div>
        </form>

        <hr />
        <!--TABLA-->
        <div class="row">
            <div class="col-sm-12">
                <table id="tabla" class="display cell-border" style="width:100%">

                    <thead>
                        <tr>
                            <th>Fecha De Venta</th>
                            <th>Cliente</th>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                            <th>Sub-Total</th>
                            <th> N° De Transaccion</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>



<!-- Reportes de ventas y productos-->
<div class="row mb-2 d-flex" style="min-height: 500px;">

    <div class="col-md-6 d-flex">
        <div class="card flex-fill">
            <div class="card-header">
                <i class="fas fa-tags me-1"></i>
                REPORTES DE VENTAS
            </div>
            <div class="card-body">
                <canvas id="myBarChart" width="100" height="80"></canvas>
            </div>
        </div>
    </div>

    <!-- Card: Reporte de Productos (con margen izquierdo) -->
    <div class="col-md-6 d-flex">
        <div class="card flex-fill ms-md-3 mt-3 mt-md-0">
            <div class="card-header">
                <i class="fas fa-boxes me-1"></i>
                REPORTE DE PRODUCTOS
            </div>
            <div class="card-body">
                <canvas id="myPieChart"></canvas>
            </div>
        </div>
    </div>
</div>

<br />


@section scripts{
<script>


    var controlBar = document.getElementById("myBarChart");//capturando el camvas

    var graficobar = new Chart(controlBar, {

        type: 'bar',
        data: {
            labels: ["January", "February", "March", "April", "May", "June", "July"],
            datasets: [
                {
                    label: "Reporte De Ventas ",
                    backgroundColor: "#66CDAA",
                    data: [4215,5312,6251,7841,9821,14984,5600]
                }
            ]
        },
        options: {
            scales: {
                xAxes: [{
                    gridLines: {
                        display:false
                    }
                }],
                yAxes: [{
                    gridLines: {
                        display: true
                    }
                }]
            }
        }
    })

    //garfico de productos
    var controlPie = document.getElementById("myPieChart");
    var graficoPie = new Chart(controlPie, {
        type: 'pie',
        data: {
            labels: ["Marketing", "Recursos Humanos", "Operaciones", "Comercial", "Business Intelligence"],
            datasets: [{
                data: [12.21, 15.58, 11.25, 8.32],
                backgroundColor: ['#9470DB', '#70E0E0', '#71C3A0', '#466478', '#E6E6E6'],
            }]
        }
    })



    var tablaData;

    $(document).ready(function () {


          //Rporte de los Card obteniendo la data
          jQuery.ajax({
             url: '@Url.Action("VistaDashboard","Home")',//llamando al controlador
             type: "GET",
             dataType: "json",
             contentType: "application/json; charset=utf-8",
             success: function (data)
             {
                //reciebiendo objeto en tipo de ejecucion
                 var objeto = data.resultado;

               //poblando los cards
               $("#totalClientes").text(objeto.TotalClientes)
               $("#totalVentas").text(objeto.TotalVenta)
               $("#totalProductos").text(objeto.TotalProducto)
               $("#gananciasTotales").text(parseFloat(objeto.GananciaTotal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

             }
          });


          //pintando el calendario en los campos de fecha
          $("#txtFechainicio").datepicker({ dateFormat: 'dd/mm/yy' }).datepicker('setDate', new Date());
          $("#txtFechaFin").datepicker({ dateFormat: 'dd/mm/yy' }).datepicker('setDate', new Date());




          //llamando al sp de los reportes por fecha
           var Url = '@Url.Action("ListaVentas", "Home")' +
             "?fechainicio=" + $("#txtFechainicio").val() +
             "&fechafin=" + $("#txtFechaFin").val() +
            "&numeroTransaccion=" + $("#txtTransaccion").val()


             //cargando data al dataTable que muestra el reporte de las ventas
             tablaData = $("#tabla").DataTable({

                 responsive: true,
                 ordering: false,

                     //pintando la data
                     "ajax":
                     {
                          url: Url,//url que viene del controlador
                          type: "GET",//metodo de tipo GET ya que optiene la data desde la base de datos
                         dataType: "json"//especificandole la data de tipo json
                     },


                      //pasandole las columnas
                      "columns": [
                          {"data": "FechaDeVenta"},
                          {"data": "Cliente"},
                          {"data": "Producto"},
                          {"data": "Precio"},
                          {"data": "Cantidad"},
                          { "data": "Total" },
                          { "data": "NumeroTransaccion"}
                      ],

                      "language": {
                        "url": "//cdn.datatables.net/plug-ins/2.1.6/i18n/es-MX.json"
                      }
             });

    })

    //llamado al evento del boton buscar
    $("#btnBuscar").on("click", function () {
          var nuevaUrl = '@Url.Action("ListaVentas", "Home")' +
            "?fechainicio=" + $("#txtFechainicio").val() +
            "&fechafin=" + $("#txtFechaFin").val() +
            "&numeroTransaccion=" + $("#txtTransaccion").val()

        tablaData.ajax.url(nuevaUrl).load();
    })

    </script>
}
