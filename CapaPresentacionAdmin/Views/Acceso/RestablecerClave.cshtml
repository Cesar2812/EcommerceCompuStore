
@{
    Layout = null;
}

<!DOCTYPE html> 

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>RestablecerClave</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .bg-dark-gray{
            background-color: #ced4da;
        }
        .custom-alert {
            width: 350px;
            padding: 10px;
            box-shadow: none;
            border-radius: 8px;
        }

        .btn-login {
            background-color: #00415d;
            color: #fff;
            font-size: 16px;
            padding: 10px;
            width: 35%;
            border: none;
            border-radius: 8px;
        }

            .btn-login:hover {
                background-color: #00415d;
                color: white;
            }

    </style>
</head>
<body class="bg-dark-gray">
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-5">
                            <div class="card shadow-lg border-0 rounded-lg mt-5">
                                <div class="card-header">
                                <h3 class="text-center my-4" style="color: #00415d;"> RECUPERACION DE CLAVE </h3></div>
                                <div class="card-body">
                                    <div class="small mb-3 text-muted"> Ingrese su Correo y le enviaremos una nueva Contraseña.</div>

                                    <form action="@Url.Action("RestablecerClave","Acceso")" method="post">
                                        <div class="form-floating mb-3">
                                            <input class="form-control" name="correo" autocomplete="off"/>
                                            <label for="inputEmail">Email address</label>
                                        </div>


                                        <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                            <a class="small" href="@Url.Action("Index","Acceso")"> Regresar al Login </a>
                                            <button class="btn btn-login" type="submit"> Restablecer </button>
                                            @*<button class="btn btn-primary" type="submit" > Restablecer </button>*@
                                        </div>

                                    </form>

                                </div>
                                <div class="card-footer text-center py-4">
                                    <div class="small"><a href="register.html"></a></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="~/Scripts/bootstrap.bundle.js"></script>

    <script>

        @if (ViewBag.Error != null)
         {
        <text>
          Swal.fire({
          position: "top-end",
          icon: "error",
          title: "@ViewBag.Error",
          showConfirmButton: false,
          timer: 1000,
          customClass:
          {
          popup: 'custom-alert'
          }
         });
         </text>
         }

           //alert que se va a ejecutar cuando se cammbie correctaente la clave
             @if (TempData["SuccessMessage"] != null)
             {
               <text>
                  Swal.fire({
                      position: "top-end",
                      icon: "success",
                      title: "Clave Cambiada Exitosamente",
                      showConfirmButton: false,
                      timer: 1000,
                      customClass: {
                          popup: 'custom-alert'
                      }
                  }).then((result) => {
                      window.location = '@Url.Action("Index", "Acceso")';
                  });
                </text>
              }
    </script>
</body>
</html>
