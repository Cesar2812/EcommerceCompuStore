<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        .swal-border {
            padding: 10px;
            box-shadow: none;
            border-radius: 8px;
        }
    </style>

    <title>@ViewBag.Title - CompuStore</title>
    @Styles.Render("~/Content/css")
</head>
<body class="sb-nav-fixed">

    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <!-- INICIO DE LA BARRA DE NAVEGACION PANEL DE ADMINISTRACION DE LA TIENDA -->
        <a class="navbar-brand ps-3" href="@Url.Action("Index","Home")">
            <div class="d-flex align-items-center mt-3">
                <img src="~/Content/images/LOGO.png" alt="Logo" style="height: 40px; width: 150px; margin-right: 10px;">

            </div>
        </a>

        <!-- MENU HAMBURGUESA-->
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>

        <!-- BARRA DE NAVEGACION DE LA DERECHA PARA LOS USUARIOS-->
        <ul class="navbar-nav ms-auto me-0 me-md-3 my-2 my-md-0">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-user fa-fw"></i></a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <li><a class="dropdown-item">@User.Identity.Name</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="btn btn-danger text-white mx-auto" href="javascript:void(0);" onclick="confirmLogout();" style="width: 145px; padding: 0.345rem 0.60rem; border-radius: 0.25rem; text-align: center; display: block;">Cerrar Sesión</a>
                    </li>

                </ul>
            </li>
        </ul>
    </nav>

  
    <!-- MENU DE NAVEGACION DINAMICO -->
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav mt-4">

                        <!-- RESUMEN DE TRANSACCIONES -->
                        <div class="nav-item">

                            <a class="nav-link collapsed dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#collapseTransacciones" aria-expanded="false">
                                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                                Transacciones
                            </a>

                            <div class="collapse" id="collapseTransacciones" data-bs-parent="#sidenavAccordion">

                                <nav class="sb-sidenav-menu-nested nav">
                                    <a class="nav-link" href="@Url.Action("Index","Home")">
                                        <div class="sb-nav-link-icon"><i class="fas fa-list"></i></div>
                                        Ver Transacciones
                                    </a>
                                </nav>

                            </div>

                        </div>

                        <!-- CATALOGOS -->
                        <div class="nav-item">
                            <a class="nav-link collapsed dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#collapseCatalogos" aria-expanded="false">
                                <div class="sb-nav-link-icon"><i class="fas fa-cog"></i></div>
                                Configuración
                            </a>

                            <div class="collapse" id="collapseCatalogos" data-bs-parent="#sidenavAccordion">
                                <nav class="sb-sidenav-menu-nested nav">
                                    <a class="nav-link" href="@Url.Action("Categorias","Catalogos")">
                                        <div class="sb-nav-link-icon"><i class="fas fa-table"></i></div>
                                        Categorías
                                    </a>
                                    <a class="nav-link" href="@Url.Action("Marcas","Catalogos")">
                                        <div class="sb-nav-link-icon"><i class="fas fa-bookmark"></i></div>
                                        Marcas
                                    </a>
                                    <a class="nav-link" href="@Url.Action("Productos","Catalogos")">
                                        <div class="sb-nav-link-icon"><i class="fas fa-boxes"></i></div>
                                        Productos
                                    </a>

                                    <!-- SERVICIOS -->
                                    <a class="nav-link collapsed dropdown-toggle" href="#" data-bs-toggle="collapse" data-bs-target="#collapseServicios" aria-expanded="false">
                                        <div class="sb-nav-link-icon"><i class="fas fa-shopping-bag"></i></div>
                                        Servicios
                                    </a>

                                    <div class="collapse" id="collapseServicios">
                                        <nav class="sb-sidenav-menu-nested nav">
                                            <a class="nav-link" href="@Url.Action("Reparacion","Servicios")">
                                                <div class="sb-nav-link-icon"><i class="fas fa-wrench"></i></div>
                                                 Reparacion y Mantenimiento
                                            </a>
                                        </nav>
                                    </div>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/complementos")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

<script>
          function confirmLogout() {
              Swal.fire({
                  position: "top-end",
                  title: '¿Estas seguro que desea cerrar sesión?',
                  icon: 'warning',
                  width: '400px',

                  showCancelButton: true,
                  confirmButtonColor: '#3085d6',
                  cancelButtonColor: '#d33',
                  confirmButtonText: 'Sí',
                  cancelButtonText: 'No',
                  customClass: {
                      popup: 'swal-border'
                  }
              }).then((result) => {
                  if (result.isConfirmed) {
                      window.location.href = '/Acceso/CerrarSesion';
                  }
              });
          }


    document.addEventListener("DOMContentLoaded", function() {
        // Verificar si existe un mensaje en TempData para mostrar la alerta
        @if (TempData["NombreUsuario"] != null)
         {
            <text>
            Swal.fire({
                title: '¡Bienvenido!@TempData["NombreUsuario"]',
                icon: 'success',
                customClass: {
                    popup: 'swal-border'
                },
                timer: 1550,
                showConfirmButton: false
            });
            </text>
         }
    });
</script>
</body>
</html>
