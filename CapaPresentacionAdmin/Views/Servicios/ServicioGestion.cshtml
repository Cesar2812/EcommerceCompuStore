
@{
    ViewBag.Title = "ServicioGestion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<nav aria-label="breadcrumb" style="margin-top:10px">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#">Servicios De la Tienda</a></li>
        <li class="breadcrumb-item active" aria-current="page">Registrar Servicio De Reparacion o Mantenimiento</li>
    </ol>
</nav>

<div class="card">
    <div class="card-header">
        <i class="fas fa-tasks me-1"></i> GESTION DE SERVICIOS A DISPOSITIVOS
        <button id="btnTerminarGuardarVenta" class="btn btn-warning btn-sm float-end">
            <i class="fa fa-print"></i> Imprimir y Terminar la Gestion
        </button>
    </div>

    <div class="card-body p-2 card-venta">
        <div class="row">
            <div class="col-md-3 mb-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-gradient text-black">Fecha del Servicio</span>
                    <input id="txtfechaventa" type="text" class="form-control" readonly>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-sm-6">
                <div class="card border-dark">
                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-black">DATOS DEL CLIENTE</h6>
                        <div class="row align-items-end">
                            <div class="col-sm-4">
                                <div class="form-group mb-0">
                                    <label for="txtclientenombres" class="col-form-label col-form-label-sm">Nombres: <span class="required">*</span></label>
                                    <input type="text" class="form-control form-control-sm model" id="txtclientenombres" name="RazonSocial" autocomplete="off">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group mb-0">
                                    <label for="txtclientetelefono" class="col-form-label col-form-label-sm">Teléfono:</label>
                                    <input type="text" class="form-control form-control-sm model" id="txtclientetelefono" name="RazonSocial" autocomplete="off">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="row">
                    <div class="col-12">
                        <h6 class="text-black">DETALLE DE SERVICIOS</h6>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="table-responsive-sm">
                            <table id="tbVenta" class="table table-striped table-bordered nowrap table-sm" style="width:100%">
                                <thead class="table-dark">
                                    <tr>
                                        <th></th>
                                        <th>Dispositivo</th>
                                        <th>Descripción</th>
                                        <th>Precio</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-dark">
                    <div class="card-body p-2">
                        <h6 class="card-title mb-1 text-black">SERVICIOS</h6>
                        <input id="txtIdProducto" type="hidden" value="0">

                        <div class="mb-2">
                            <label for="txtproductonombre" class="form-label form-label-sm">Dispositivo:</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm model" id="txtproductonombre" name="Nombre" readonly>
                                <button id="btnBuscarProducto" type="button" class="btn btn-sm btn-primary">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="txtproductodescripcion" class="form-label form-label-sm">Descripción del Servicio:</label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <textarea class="form-control form-control-sm model" id="txtproductodescripcion" name="Descripcion" readonly></textarea>
                                </div>
                                <label for="txtproductoprecio" class="form-label form-label-sm">Precio del Servicio:</label>
                                <div class="col-md-3">
                                    <input type="text" class="form-control form-control-sm model" id="txtproductoprecio" name="Nombre" readonly>
                                </div>
                                <div class="col-md-3">
                                    <button id="btnAgregar" type="button" class="btn btn-sm btn-success w-100">
                                        <i class="fa fa-plus" aria-hidden="true"></i> Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr />
        <div class="row">
            <div class="col-sm-6">
                <div class="row">
                    <div class="col-sm-4">
                        <div class="input-group input-group-md">
                            <label class="input-group-text bg-light text-black" style="min-width: 70px;" for="txtsubtotal">SubTotal</label>
                            <input id="txtsubtotal" readonly type="text" class="form-control form-control-md" value="0">
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="input-group input-group-md">
                            <label class="input-group-text bg-light text-black" style="min-width: 80px;" for="txtigv">IVA 15%</label>
                            <input id="txtigv" readonly type="text" class="form-control form-control-md" value="0">
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="input-group input-group-md">
                            <label class="input-group-text bg-light text-black" style="min-width: 80px;" for="txttotal">Total</label>
                            <input id="txttotal" readonly type="text" class="form-control form-control-md" value="0">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="d-flex align-items-start gap-2">
                    <div class="input-group input-group-md" style="flex: 1 1 180px;">
                        <label class="input-group-text bg-light text-black" for="txtmontopago">Monto Pago</label>
                        <input id="txtmontopago" type="text" class="form-control form-control-md" autocomplete="off">
                    </div>

                    <button id="btncalcular" type="button" class="btn btn-sm btn-success mt-1" style="white-space: nowrap;">
                        C$ Calcular
                    </button>

                    <div class="input-group input-group-md" style="flex: 1 1 140px;">
                        <label class="input-group-text bg-light text-black" for="txtcambio">Cambio</label>
                        <input id="txtcambio" readonly type="text" class="form-control form-control-md">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- MODAL PRODUCTOS -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Productos</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="tbProducto" class="table table-striped table-bordered nowrap compact" style="width:100%">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Codigo</th>
                                <th>Nombre</th>
                                <th>Descripcion</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>




