
@{
    ViewBag.Title = "Servicios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!--TITULO DE LA SECCION DE CATEGORIAS-->
<div class="card-header fs-4 mt-2">
    <i class="fas fa-mobile-alt me-1 fa-1x"></i> GESTIONAR SERVICIO
</div>



<!--Muestra las secciones para devolver entre-->
<ol class="breadcrumb mb-4 mt-2">
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Transacciones</a></li>
    <li class="breadcrumb-item active">Servicio a Dispositivos</li>
</ol>


<div class="card mt-3">
    <div class="card-header">
        <i class="fa fa-wrench me-1 fa-1x"></i> GESTION DE SERVICIOS DE REPARACION Y MANTENIMIENTO
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-sm-4">
                <div class="mb-2">
                    <label for="exampleInputEmail1" class="form-label">Dispositivo</label>
                    <input type="text" class="form-control form-control-sm" id="txtCedulaCliente">
                </div>
            </div>

            <div class="col-sm-4">
                <div class="mb-2">
                    <label class="form-label">Tipo De Servicio</label>
                    <select id="comboTipo_Servicio" class="form-select">
                    </select>
                </div>
            </div>
        </div>



        <hr />

        <div class="row align-items-start">
            <div class="col-sm-3">
                <div class="mb-2">
                    <label for="txtProducto" class="form-label">Descripcion Del Servicio</label>
                    <textarea class="form-control" id="txtDesServicio"></textarea>
                </div>
            </div>

            <div class="col-sm-3">
                <div class="mb-2">
                    <label for="txtPrecio" class="form-label">Precio del Servicio</label>
                    <input type="text" class="form-control" id="txtPrecio">
                </div>
            </div>

            

            <div class="col-sm-3">
                <div class="mb-2">
                    <label class="form-label d-block invisible">Acciones</label> <!-- espacio invisible para alinear -->
                    <!-- Botón Agregar -->
                    <button class="btn btn-success" id="btnAgregar">
                        <i class="fas fa-arrow-down me-1"></i> Agregar
                    </button>

                    <!-- Botón Terminar -->
                    <button class="btn btn-primary" id="btnTerminar">
                        <i class="fas fa-save me-1"></i> Guardar
                    </button>
                </div>
            </div>
        </div>



        <hr />

        <div class="row">
            <div class="col-12">
                <table class="table table-bordered table-sm" id="tbServcio">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">SERVICIO</th>
                            <th scope="col">PRECIO</th>
                            <th scope="col">DESCRIPCION</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!--CARD DONDE VA A ESTAR EL DATATABLE-->
<div class="card mt-3">
    <div class="card-header">
        <i class="fas fa-tv me-1"></i>Listado de Servicios
    </div>



    <div class="card-body">

       

        <!--Creando Tabla-->
        <table id="tabla" class="display cell-border" style="width:100%">
            <thead>
                <tr>
                    <th>Dispositivo</th>
                    <th>Servicio</th>
                    <th>Precio</th>
                    <th>Descripcion</th>

                </tr>
            </thead>

            <tbody>
            </tbody>

        </table>
    </div>
</div>


@section scripts
{
<script>

    let precio;

            var tablaData;
            //cargando data al dataTable
            tablaData = $("#tabla").DataTable({

                responsive: true,
                ordering: false,

                //pintando la data
                "ajax": {
                    url: '@Url.Action("ListarServicios", "Servicios")',//url que viene del controlador
                    type: "GET",//metodo de tipo GET ya que optiene la data desde la base de datos
                    dataType: "json"//especificandole la data de tipo json
                },
                //pasandole las columnas
                "columns": [
                    { "data": "NombreDispositivo" },
                    {
                        //renderizando la columna Marca
                        "data": "objTipoServicio", "render": function (data) {
                            return data.Descripcion
                        }
                    },
                    { "data": "Precio" },

                    {
                        "data": "Descripcion_Servicio",
                        "orderable": true,
                        "searchable": false
                    },
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/2.1.6/i18n/es-MX.json"
                }
            });


    //cargando data de TipoDe servicio en los select la peticion es de tipo get ya que se obtienen datos del servidor
        jQuery.ajax({
            url: '@Url.Action("ListarTipoServicio", "Servicios")',
            type: "GET",
            data: null,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data)
            {
                $("#comboTipo_Servicio").empty();

                $("<option>")
                    .attr({ value: "0", disabled: true, selected: true })
                    .text("Seleccione Uno")
                    .appendTo("#comboTipo_Servicio");
                
                $.each(data.data, function (index, item)
                {
              
                    $("<option>").attr({ "value": item.id_TipoServicio }).text(item.Descripcion).appendTo("#comboTipo_Servicio");
                })
            },
            error: function (error)
            {
                console.log(error)
            }
        });

        //evento click del boton agregar
        $("#btnAgregar").on("click", () => {
            //en el evnto click del boton capturo la data y se almacenan en variables
            let DescripcionServicio = $("#txtDesServicio").val().trim();
            precio = parseFloat($("#txtPrecio").val().trim());
            let tipo_Servicio = $("#comboTipo_Servicio option:selected").text();
            let idTipoServicio = $("#comboTipo_Servicio").val();

            
            const filasTabla = $("#tbServcio tbody tr").length;

            // Validación 1: todos los campos vacíos Y la tabla vacía
            if (DescripcionServicio === "" && precio === "" && filasTabla === 0) {
                Swal.fire({
                    icon: "warning",
                    title: "Campos vacíos",
                    text: "Debe ingresar información en los campos o agregar al menos un servicio a la tabla.",
                    timer: 1500,
                    showConfirmButton: false
                });
                return;
            }

            // Validación 2: si hay campos llenos pero alguno está incompleto
            if (DescripcionServicio === "" || precio === "") {
                Swal.fire({
                    icon: "warning",
                    title: "Campos incompletos",
                    text: "Debe completar todos los campos antes de agregar.",
                    timer: 1500,
                    showConfirmButton: false
                });
                return;
            } 

            // Validación 3: verificar que el precio sea un número válido y mayor a cero
            if (isNaN(precio) || parseFloat(precio) <= 0) {
                Swal.fire({
                    icon: "error",
                    title: "Precio inválido",
                    text: "El campo precio debe contener un número válido mayor a cero.",
                    timer: 1500,
                    showConfirmButton: false
                });
                return;
            }

            // Validación 4: verificar que se haya seleccionado un tipo de servicio válido
            if (idTipoServicio === "0" || idTipoServicio === null) {
                Swal.fire({
                    icon: "warning",
                    title: "Tipo de servicio no seleccionado",
                    text: "Por favor, seleccione un tipo de servicio antes de agregar.",
                    timer: 1500,
                    showConfirmButton: false
                });
                return;
            }

            //se crea una nueva fila en base al tr columna en el body de la tabla con una nueva fila td
            $("#tbServcio tbody").append(
                $("#tbServcio tbody").append(
                    $("<tr>").attr("data-id", idTipoServicio).append(
                        $("<td>").text(tipo_Servicio),
                        $("<td>").text(precio),
                        $("<td>").text(DescripcionServicio)
                    )
                )
            )
            $("#txtDesServicio").val("");
            $("#txtPrecio").val("");
        })


            //funcion y eventp del bton terminar venta
            $("#btnTerminar").on("click", () =>{
                var Servicio = []

	                //recorremos la tabla para obtener los valores de cada fila
                    $("#tbServcio > tbody >tr").each(function (index, tr) {
                        Servicio.push({
                            id_TipoServicio: $(tr).data("id"),
                            Precio: parseFloat($(tr).find("td:eq(1)").text()),
                            Descripcion_Servicio:$(tr).find("td:eq(2)").text()

                        })
                    })

                    //creando el Servicio en un tipo object
                    var Services={
                        NombreDispositivo: $("#txtCedulaCliente").val(),
                    }

                        if (!Services.NombreDispositivo || Servicio.length === 0) {
                            Swal.fire({
                                position: "center",
                                icon: "error",
                                title: "Debe de Completar todos los campos, intente de nuevo",
                                showConfirmButton: false,
                                timer: 1550
                            });
                             return;
                        }

                 jQuery.ajax({
                    url: '@Url.Action("RegistrarServicio", "Servicios")',
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        objServicio_dispositivo: Services,
                        Detalle_Servicio: Servicio
                    }),
                        success: function (data) {

                                if (data.respuesta) {
                                    Swal.fire({
                                        position: "center",
                                        icon: "success",
                                        title: "Servicio Registrado correctamente",
                                        showConfirmButton: false,
                                        timer: 1550
                                    });

                                    $("#txtCedulaCliente").val("")
                                    $("#txtDesServicio").val("");
                                    $("#txtPrecio").val("");
                                    $("#tbServcio tbody").empty();
                                    tablaData.ajax.reload();
                               
                                } else {
                                    Swal.fire({
                                        position: "center",
                                        icon: "error",
                                        text: data.Mensaje,
                                        showConfirmButton: false,
                                        timer: 1550
                                    });
                                    $("#txtCedulaCliente").val("")
                                    $("#tbServcio tbody").empty();
                                    $("#txtPrecio").val(precio);
                                   
                                }
                        }
                    });    
            })
</script>
}