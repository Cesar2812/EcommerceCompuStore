@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container my-5">
    <div class="row">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <!--COLUMNA DE LOS PRODUCTOS DEL CLIENTE -->
                    <div class="col sm-9"> 
                        <div class="me-2">
                            <div class="d-flex justify-content-between">
                                <h5 class="ms-2 mt-2">MIS PRODUCTOS</h5>
                                <a class="btn btn-primary" href="@Url.Action("Index","Tienda")"><i class="fas fa-cart-plus"></i> Seguir Comprando</a>
                            </div>
                            <hr class="mt-2 mb-2" />

                            <div id="productos-carrito">
                                <div class="card mb-2 card-producto">
                                    <div class="card-body">

                                        <div class="row">
                                            <!--COLUMNA IMAGEN-->
                                            <div class="col-sm-2 align-self-center d-flex justify-content-center">
                                                <img class="rounded ms-2" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" style="width:90px; height:90px" />

                                            </div>

                                            <!--MARCA Y NOMBRE DEL PRODUCTO-->
                                            <div class="col-sm-4 align-self-center">
                                                <span class="font-weight-bold d-block">Nombre Producto</span>
                                                <span>Marca</span>

                                            </div>

                                            <!--PRECIO DEL PRODUCTO-->
                                            <div class="col-sm-2 align-self-center">
                                                <span>Precio : C$/. 1500</span>
                                            </div>

                                            <!--BOTONES-->
                                            <div class="col-sm-2 align-self-center">
                                                <div class="d-flex">

                                                    <button class="btn btn-danger btn-restar rounded-0">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <input class="form-control input-cantidad p-1 text-center rounded-0" disabled style="width:40px" />

                                                    <button class="btn btn-success btn-sumar rounded-0 me-1">
                                                        <i class="fas fa-plus"></i>
                                                    </button>

                                                    <button class="btn btn-outline-warning btn-eliminar d-flex justify-content-center align-items-center" style="width: 35px;">
                                                        <i class="far fa-trash-alt"></i>
                                                    </button>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <label class="align-self-center"><b>SUB-TOTAL:  C$ <span id="Total">500</span></b></label>
                            </div>

                            <div class="d-flex justify-content-end">
                                <label class="align-self-center"><b>+ IVA  <span id="iva">15%</span></b></label>
                            </div>

                            <div class="d-flex justify-content-end">
                                <label class="align-self-center"><b>TOTAL:  C$ <span id="TotalmasIva">500</span></b></label>
                            </div>
                        </div>

                    </div>

                    <!--COLUMNA DE LOS DATOS DEL CLIENTE PARA ENVIO-->
                    <div class="col sm-3">
                        <div class="card">
                            <div class="card-body bg-light">
                                <h5 class="card-title"> DATOS DE SU COMPRA Y DETALLE DEL ENVIO</h5>
                                <form>

                                    <div class="mb-2">
                                        <label for="comboDepartamento" class="form-label"> Departamento </label>
                                        <select class="form-select form-select-sm" id="comboDepartamento"></select>
                                    </div>

                                    <div class="mb-2">
                                        <label for="comboMunicipio" class="form-label"> Municipio </label>
                                        <select class="form-select form-select-sm" id="comboMunicipio"></select>
                                    </div>

                                    <div class="mb-2">
                                        <label for="exampleInputEmail1" class="form-label"> Nombre Del Cliente o Contacto </label>
                                        <input type="text" class="form-control form-control-sm" id="txtContacto" autocomplete="off" />
                                    </div>

                                    <div class="mb-2">
                                        <label for="exampleInputEmail1" class="form-label"> Direccion </label>
                                        <input type="text" class="form-control form-control-sm" id="txtDireccion" autocomplete="off" />
                                    </div>

                                    <div class="mb-2">
                                        <label for="exampleInputEmail1" class="form-label"> Telefono </label>
                                        <input type="text" class="form-control form-control-sm" id="txtTelefono" autocomplete="off" />
                                    </div>

                                    <div class="d-grid">
                                        <button class="btn btn-success" type="button" onclick="RealizarPago()">
                                            <i class="fab fa-paypal"></i> TERMINAR Y PROCESAR EL PAGO

                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{ 
<script>

    //metodo para listar productos en el carrito de la tienda 
     $(document).ready(function ()
     {
         jQuery.ajax({
             url: '@Url.Action("ListarProductosCarrito", "Tienda")',
             type: "POST",
             dataType: "json",
             contentType: "application/json; charset=utf-8",
             success: function (response)
             {
                 $("#productos-carrito").html("");

                 $("#productos-carrito").LoadingOverlay("hide");

                 $.each(response.data, function (i, item)
                 {
                     $("<div>").addClass("card mb-2 card-producto").append(
                         $("<div>").addClass("card-body").append(
                             $("<div>").addClass("row").append(
                                 //1
                                 $("<div>").addClass("col-sm-2 align-self-center d-flex justify-content-center").append(
                                     $("<img>").addClass("rounded ms-2").attr({ "src": "data:image/" + item.objProd.Extension + ";base64," + item.objProd.Base64 })
                                         .css({ "width": "90px", "height":"90px"})
                                 ),
                                 //2
                                 $("<div>").addClass("col-sm-4 align-self-center").append(
                                     $("<span>").addClass("font-weight-bold d-block").text(item.objProd.Nombre),
                                     $("<span>").text(item.objProd.objMarca.Descripcion)
                                 ),

                                 //3
                                 $("<div>").addClass("col-sm-2 align-self-center").append(
                                     $("<span>").html(
                                         "<div style='display: flex; align-items: center; margin-left: -10px;'>" +  // Ajuste a la izquierda
                                         "<span style='margin-right: 5px;'>C$</span>" +
                                         "<span>" +
                                         item.objProd.Precio.toLocaleString("es-HN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) +
                                         "" +
                                         "</span>" +
                                         "</div>"
                                     )
                                 ),
                                 //4
                                 $("<div>").addClass("col-sm-2 align-self-center").append(
                                     $("<div>").addClass("d-flex").append(
                                         $("<button>").addClass("btn btn-danger btn-restar rounded-0").append($("<i>").addClass("fas fa-minus")),
                                         $("<input>").addClass("form-control input-cantidad p-1 text-center rounded-0").attr({ "disabled": "disabled" }).css({ "width": "40px" }).data("objProd", item.objProd).val(item.Cantidad),
                                         $("<button>").addClass("btn btn-success btn-sumar rounded-0 me-1").append($("<i>").addClass("fas fa-plus")),
                                         $("<button>").addClass("btn btn-outline-warning btn-eliminar d-flex justify-content-center align-items-center").css({ "width": "35px" }).append($("<i>").addClass("far fa-trash-alt")).data("idProducto", item.objProd.id_Producto),

                                     )
                                 )
                             )

                         )

                     ).appendTo("#productos-carrito")

                 })

                 sumarTotal();
             },
             error: function (error)
             {
                 $("#productos-carrito").LoadingOverlay("hide");

             },
             beforeSend: function ()
             {
                 $("#productos-carrito").LoadingOverlay("show");

             }

         })

         ListarDepartamentos();
     })


        //funcion para listar los departamentos y los municipios determinados
     function ListarDepartamentos()
     {
            $("<option>").attr({ "value": "00","disabled":"disabled","selected":"true"}).text("Seleccionar Departamento").appendTo("#comboDepartamento")

            jQuery.ajax({
                url: '@Url.Action("ObtenerDepartamento", "Tienda")',
                type: "POST",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data)
                {
                    //si hay data osea diferente de null
                    if (data.lista != null)
                    {
                        $.each(data.lista, function (i, item) {
                            $("<option>").attr({ "value": item.idDepartamento }).text(item.NombreDepartamento).appendTo("#comboDepartamento")


                        })
                        ListarMunicipio();

                    }


                }

            })

     }

     $("#comboDepartamento").on("change", function ()
     {
         ListarMunicipio();
     })

      //funcion para listar Municipios en base a un Departamento
     function ListarMunicipio()
     {
          $("#comboMunicipio").html("")

          $("<option>").attr({ "value": "00", "disabled": "disabled", "selected": "true" }).text("Seleccionar Municipio").appendTo("#comboMunicipio")

           jQuery.ajax({
                  url: '@Url.Action("ObtenerMunicipio", "Tienda")',
                  type: "POST",
                  data: JSON.stringify({ iddepartamento: $("#comboDepartamento option:selected").val()}),
                  dataType: "json",
                  contentType: "application/json; charset=utf-8",
                  success: function (data)
                  {
                      //si hay data osea diferente de null
                       if (data.lista != null)
                       {
                          $.each(data.lista, function (i, item) {
                              $("<option>").attr({ "value": item.idMunicipio }).text(item.NombreMunicipio).appendTo("#comboMunicipio")


                          })

                       }


                  }

           })

     }


     //funcion para sumar los precios de los productos
     function sumarTotal() {
         var sumaTotal = parseFloat(0)
         var sumaiva = parseFloat(0)

         var SumaTotalIva = parseFloat(0)

         $("input.input-cantidad").each(function (i) {
             var precio = $(this).data("objProd").Precio;
             var cantidad = parseFloat($(this).val())

             var subtotal = precio * cantidad;// multiplicacion del precio por la cantidad

             sumaTotal += subtotal;//suma del subtotal(precio * cantidad)

             sumaiva = sumaTotal * 0.15;//aplicacion del iva al total

             SumaTotalIva = sumaTotal + sumaiva //suma del subtotal mas el iva aplicado
         })

         
         $("#Total").text(sumaTotal.toLocaleString("es-HN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }))
         $("#Total").data("sumatotal", sumaTotal) // para enviarlo después a la base de datos
         $("#TotalmasIva").text(SumaTotalIva.toLocaleString("es-HN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }))
         $("#TotalmasIva").data("sumatotaliva", SumaTotalIva)// para enviarlo a la base de datos
       
     }



     //Aumentar la cantidad de Producto dentro del carrito
     $(document).on("click", ".btn-sumar", function ()
     {
         var div_container = $(this).parent("div.d-flex");

         var input_cantidad = $(div_container).find("input.input-cantidad");

         var btn = $(this)

         var idproducto = $(input_cantidad).data("objProd").id_Producto;

         jQuery.ajax({

             url: '@Url.Action("OperacionCarro", "Tienda")',
             type: "POST",
             data: JSON.stringify({ idProducto: idproducto, sumar: true }),
             dataType: "json",
             contentType: "application/json; charset=utf-8",
             success: function (data)
             {
                 $(btn).LoadingOverlay("hide")

                 if (data.respuesta) {
                     var cantidad = parseInt($(input_cantidad).val()) + 1;
                     $(input_cantidad).val(cantidad);
                     sumarTotal();

                 } else
                 {
                     swal("", data.mensaje, "warning");

                 }
             },
             beforeSend: function ()
             {
                 $(btn).LoadingOverlay("show")
             },
             error: function (error)
             {
                 $(btn).LoadingOverlay("hide")

             }



         })
     })

     //funcion para restar en el carrito
    $(document).on("click", ".btn-restar", function ()
    {
        var div_container = $(this).parent("div.d-flex");

        var input_cantidad = $(div_container).find("input.input-cantidad");

        var btn = $(this)

        var idproducto = $(input_cantidad).data("objProd").id_Producto;

        var cantidad = parseInt($(input_cantidad).val()) -1;

        if (cantidad >= 1)
        {
            jQuery.ajax({

                url: '@Url.Action("OperacionCarro", "Tienda")',
                type: "POST",
                data: JSON.stringify({ idProducto: idproducto, sumar: false }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data)
                {
                    $(btn).LoadingOverlay("hide")

                    if (data.respuesta) {

                        $(input_cantidad).val(cantidad)
                        sumarTotal();

                    } else
                    {
                        swal("", data.mensaje, "warning");

                    }
                },
                beforeSend: function ()
                {
                    $(btn).LoadingOverlay("show")
                },
                error: function (error)
                {
                    $(btn).LoadingOverlay("hide")

                }
            })
        }
    })



    //metodo para eliminar producto del carrito
    $(document).on("click", ".btn-eliminar", function () {
        var idproducto = $(this).data("idProducto");
       var card_producto = $(this).parents("div.card-producto");

            // SweetAlert para confirmar eliminación
            Swal.fire({
                title: "¿Esta Seguro?",
                text: "¿Desea eliminar el Producto del Carrito?",
                icon: "warning",
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí",
                cancelButtonText: "No"
            }).then((result) => {
                if (result.isConfirmed) {
                    
                    $.ajax({
                        url: '@Url.Action("EliminarProductoCarrito", "Tienda")',
                        type: "POST",
                        data: JSON.stringify({ idProducto: idproducto }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.respuesta) {
                                card_producto.remove();
                                MostrarCantidaCarrito();
                                sumarTotal();
                            } else {
                                Swal.fire("", data.mensaje, "warning");
                            }
                        }
                    });
                }
            });
    }); 


    //funcion para realizar pago mediante Paypal
    function RealizarPago() {

        if(parseInt($("#cantidadCarro").text())==0){
            Swal.fire("", "No hay productos en el carro", "warning");
            return
        }

        if ($("#comboMunicipio").val() == null || $("#txtContacto").val() == "" || $("#txtDireccion").val() == "" || $("#txtTelefono").val() == "")
        {
            Swal.fire("", "Debe Completar los datos del envio", "warning");
            return
        } 

        //creando un json de la venta 
        var Venta = {
            TotalProducto: $("input.input-cantidad").length,
            MontoTotal: 0,
            Contacto: $("#txtContacto").val(),
            idMunicipio: $("#comboMunicipio").val(),
            Telefono: $("#txtTelefono").val(),
            Direccion: $("#txtDireccion").val(),
            MontoTotalIva:0,
        }  

        var lista_carrito = [];

        $("input.input-cantidad").each(function (i) {

            var producto = $(this).data("objProd");
            var cantidad = parseFloat($(this).val())

            lista_carrito.push({
                objProd: producto,
                Cantidad:cantidad

            })

        })


        jQuery.ajax({
            url: '@Url.Action("ProcesarPago","Tienda")',
            type: "POST",
            data: JSON.stringify({ olistaCarrito: lista_carrito, oVenta: Venta }),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) { 
                $.LoadingOverlay("hide")
                if (data.Status) {

                    var jsonResult = data.Response;

                    var links = jsonResult.links;

                    var resultado = links.find(item => item.rel === "approve");

                    window.location.href = resultado.href


                } else {
                    swal("", "Vuelva a intenatrlo mas tarde", "warning");
                }
            }, beforeSend: function ()
            {
                $.LoadingOverlay("show")

            },
            error: function (error)
            {

                $.LoadingOverlay("hide")
            }
        })
    }
 </script> 
}

