@model CapaEntidad.Producto
@{
    ViewBag.Title = "DetalleProducto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">
            <div class="col-md-6"><img class="card-img-top mb-5 mb-md-0" src="data:image/@Html.DisplayTextFor(m => m.Extension);base64,@Html.DisplayTextFor(m=>m.Base64)" alt="..." /></div>
            <div class="col-md-6">

                <div class="small mb-1">Marca: @Html.DisplayTextFor(m=>m.objMarca.Descripcion)</div>

                <h1 class="display-5 fw-bolder">@Html.DisplayTextFor(m => m.Nombre)</h1>

                <div class="fs-5 mb-5">
                    @*<span class="text-decoration-line-through">$45.00</span>*@
                    <span>C$ @(Model.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)) +IVA</span>
                </div>

                <p class="lead">@Html.DisplayTextFor(m => m.Descripcion)</p>
                <div class="d-flex">
                    
                    <a href="javascript:void(0);" class="btn btn-danger w-50 text-center me-3" id="btnVolver">
                        <i class="fas fa-undo-alt"></i> Volver
                    </a>


                    @if (Session["UsuarioCliente"] != null)
                     {
                        <button class="btn btn-success agregarcarrito flex-shrink-0 w-50" type="button" data-id_producto="@Html.DisplayFor(m => m.id_Producto)">
                            <i class="fas fa-cart-plus"></i>
                            Agregar al Carrito
                        </button>


                     }
                </div>

            </div>
        </div>
    </div>
</section>

@section scripts
{
<script>
     //metodo para agregar al carrito desde ver detalle
     $(document).on("click", "button.agregarcarrito", function () {
         console.log($(this).data("id_producto"))

            jQuery.ajax({
                url: '@Url.Action("AgregarAlCarrito", "Tienda")',
                type: "POST",
                data: JSON.stringify({ idProducto: $(this).data("id_producto") }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.respuesta) {
                        MostrarCantidaCarrito();
                        swal("","Producto Agregado Correctamente al Carrito", "success");
                    }
                    else
                    {
                        swal("", data.mensaje, "warning");

                    }
                }

            });

     })

        $("#btnVolver").click(function() {
            var categoria = sessionStorage.getItem("categoria");
            var marca = sessionStorage.getItem("marca");

            // Si hay filtros guardados, redirige con esos parámetros
            if (categoria && marca) {
                window.location.href = `@Url.Action("Index", "Tienda")?categoria=${categoria}&marca=${marca}`;
            } else {
                window.location.href = "@Url.Action("Index","Tienda")";
            }
        });


        

</script>

}

