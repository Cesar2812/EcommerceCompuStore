<style>

    .accordion-button {
        background-color: white !important;
        color: black !important;
        transition: background-color 0.5s, opacity 0.5s;
        font-size: 1.2rem;
    }

        .accordion-button:hover {
            background-color: white !important;
            color: black !important;
            opacity: 0.8;
        }

        .accordion-button.active {
            background-color: rgba(0, 0, 0, 0.1) !important;
            color: black !important;
        }

    .accordion-body {
        font-size: 1.1rem;
    }




    .bg-black {
        position: relative;
        min-height: 300px;
        opacity: 0;
        transition: opacity 1s ease-out; /* Transición de opacidad */
    }

        .bg-black.visible {
            opacity: 1;
        }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5); /* Opacidad de fondo */
        z-index: 0;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Cerrar todos los acordeones excepto el primero
        document.querySelectorAll(".accordion-collapse").forEach((el, index) => {
            if (index !== 0) {
                el.classList.remove("show");
            }
        });

        // Asegurar que solo se abre uno a la vez los acordones
        document.querySelectorAll(".accordion-button").forEach(button => {
            button.addEventListener("click", function () {
                let target = this.getAttribute("data-bs-target");
                document.querySelectorAll(".accordion-collapse").forEach(el => {
                    if ("#" + el.id !== target) {
                        el.classList.remove("show");
                    }
                });
            });
        });
    });


    // Cuando se cargue la página, se agrega la clase 'visible' para activar la transición
    window.addEventListener('DOMContentLoaded', (event) => {
        document.querySelector('.bg-black').classList.add('visible');
    });
</script>