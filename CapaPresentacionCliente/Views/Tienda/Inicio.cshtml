@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .image-overlay {
        position: relative;
    }

        .image-overlay img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .image-overlay::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4); /* Capa oscura con 40% de opacidad */
        }
</style>

<main class="flex-shrink-0">
    <!--SECCION DEL CARRUSEL DE IMAGENES-->
    <header class="bg-light py-1">
        <div class="container-fluid px-0">
            <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="image-overlay">
                            <img class="d-block w-100" style="height: 70vh; object-fit: cover;" src="~/Content/images/xbox-one-x-consola-generacionxbox(3).jpg" alt="Image 1" />
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="image-overlay">
                            <img class="d-block w-100" style="height: 70vh; object-fit: cover;" src="~/Content/images/Celular-1-700x392.jpg" alt="Image 2" />
                        </div>
                    </div>
                    <div class="carousel-item">
                        <div class="image-overlay">
                            <img class="d-block w-100" style="height: 70vh; object-fit: cover;" src="~/Content/images/hq720.jpg" alt="Image 3" />
                        </div>
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
                <div class="carousel-indicators position-absolute bottom-0 start-50 translate-middle-x" style="transform: translateX(-70%);margin-left:5px">
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>
            </div>
        </div>
    </header>

    <!--Seccion de Productos destacados-->
    <section class="py-1">

        <div class="text-center mb-5">
            <h1 class="fw-bolder">Productos Mas Vendidos</h1>
        </div>

        <div class="col-sm-12">
            <div id="contenedoProducto" class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">

                <div class="col mb-5">
                    <div class="card h-100">
                        <!-- Product image-->
                        <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="..." />
                        <!-- Product details-->
                        <div class="card-body p-4">
                            <div class="text-center">
                                <!-- Product name-->
                                <h5 class="fw-bolder">Fancy Product</h5>
                                <!-- Product price-->
                                $40.00 - $80.00
                            </div>
                        </div>
                        <!-- Product actions-->
                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">View options</a></div>
                        </div>
                    </div>
                </div>

                <div class="col mb-5">
                    <div class="card h-100">
                        <!-- Sale badge-->
                        <div class="badge bg-dark text-white position-absolute" style="top: 0.5rem; right: 0.5rem">Sale</div>
                        <!-- Product image-->
                        <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="..." />
                        <!-- Product details-->
                        <div class="card-body p-4">
                            <div class="text-center">
                                <!-- Product name-->
                                <h5 class="fw-bolder">Sale Item</h5>
                                <!-- Product price-->
                                <span class="text-muted text-decoration-line-through">$50.00</span>
                                $25.00
                            </div>
                        </div>
                        <!-- Product actions-->
                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                            <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">Add to cart</a></div>
                        </div>
                    </div>
                </div>
            </div>

            <!--PAGINADOR-->
            <nav aria-label="Page navigation example">
                <ul id="paginador" class="pagination justify-content-center">
                    <!-- Aquí se generarán los enlaces de paginación -->
                </ul>
            </nav>
        </div>
    </section>


    <!-- Seccion del pensamiento-->
    <div class="py-1 bg-light">
        <div class="container px-5 my-5">
            <div class="row gx-5 justify-content-center">
                <div class="col-lg-10 col-xl-7">
                    <div class="text-center">
                        <div class="fs-4 mb-4">"En CompuStore te atendemos a como te lo mereces nos caracterizamos por nuestra atencion y calidad!"</div>
                        <div class="d-flex align-items-center justify-content-center">
                            <img class="rounded-circle me-3" src="~/Content/images/Payo.jpg" alt="..." />
                            <div class="fw-bold">
                                Pedro Pablo Cuadra
                                <span class="fw-bold text-primary mx-1">/</span>
                                Propietario
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section scripts
{
<script>

    $(document).ready(function () {
        MostrarProductosMasVendidos();
    });

    //funcion para mostrar productos mas vendidos
    function MostrarProductosMasVendidos()
    {
            jQuery.ajax({
                    url: "@Url.Action("ListarProductosMasVendidos", "Tienda")",
                    type: "GET",
                    //data: JSON.stringify({ idcategoria: _idCategoria, idMarca: _idMarca}),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                success: function (response)
                {
                    $("#contenedoProducto").html("");
                    $("#contenedoProducto").LoadingOverlay("hide");
                    $.each(response.data, function (i, element) {
                        const producto = element.objProducto;
                            $("<div>").addClass("col mb-5").append(
                                $("<div>").addClass("card h-100").append(
                                    $("<img>").addClass("card-img-top").attr({ "src": "data:image/" + producto.Extension + ";base64," + producto.Base64 }),
                                    $("<div>").addClass("card-body p-4").append(
                                        $("<div>").addClass("text-center").append(
                                            $("<h5>").addClass("fw-bolder").text(producto.Nombre),
                                            $("<h6>").text(producto.objCategoria.Descripcion),
                                            "C$ " + producto.Precio.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " +IVA"
                                        )
                                    ),

                                    $("<div>").addClass("card-footer p-2 pt-0 border-top-0 bg-transparent").append(
                                        $("<div>").addClass("d-grid gap-2").append(
                                            @if (Session["UsuarioCliente"] != null) {
                                                @:$("<button>").addClass("btn btn-success w-100 mt-auto agregarcarrito").data("id_Producto", producto.id_Producto).append($("<i>").addClass("fas fa-shopping-cart me-1"), "Add Carrito"),
                                            }

                                            $("<a>").addClass("btn btn-dark w-100 mt-auto")
                                            .attr("href", '@Url.Action("DetalleProducto", "Tienda")' + '?id_Producto=' + producto.id_Producto)
                                            .append(
                                                $("<i>").addClass("fas fa-eye me-2"),
                                                "Ver Detalle"
                                            )
                                        )
                                    )
                                )
                            ).appendTo("#contenedoProducto");
                    });
                            //// Mostrar paginación
                            //var totalPages = Math.ceil(response.total / pageSize);
                            //mostrarPaginador(totalPages, pageNumber);
                },
                beforeSend: function ()
                {
                 $("#contenedorProducto").LoadingOverlay("show");
                }
            });
    }
</script>
}