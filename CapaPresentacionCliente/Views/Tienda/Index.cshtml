@{
    ViewBag.Title = "Catalogo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Header-->
<header class="bg-black py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="text-center text-white">
            <h1 class="display-4 fw-bolder">SOMOS  CompuStore</h1>
            <p class="lead fw-normal text-white-50 mb-0"> TECNOLOGIA EN TUS MANOS</p>
        </div>
    </div>
</header> 

<style>
    .cursor-pointer {
        cursor: pointer;
    }
    #paginador {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        bottom: 485px; 
    }

    #paginador .page-item {
        margin-right: 5px; /* Agrega un pequeño margen entre los botones */
    }

    #paginador .page-link {
        color: black !important; /* Establece el color del texto a negro */
    }

    #paginador .page-item .active {
        background-color: black; /* Fondo negro */
        color: white !important; /* Texto blanco */
    }
</style>

<!--SECCION DE PRODUCTOS, CATEGORIAS Y MARCAS -->
<section>
    <div class="container-fluid px-5 my-5">

        <!--SECCION DE CATEGORIAS Y MARCAS -->
        <div class="row">
            <div class="col-sm-3">

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <!--SECCION DE CATEGORIAS -->
                        <div class="card">
                            <div class="card-header bg-black text-white">
                                CATEGORIAS
                            </div>
                            <div id="contenedor_categ" class="card-body">


                            </div>


                        </div>

                    </div>

                </div>

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <!--SECCION DE MARCAS -->
                        <div class="card">
                            <div class="card-header bg-black text-white">
                                MARCAS
                            </div>

                            <div id="contenedor_marca" class="card-body">


                            </div>


                        </div>


                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-12">
                        <div class="d-grid gap-2">
                            <button id="btnFiltro" class="btn btn-outline-dark btn-block" type="button">
                                <i class="fas fa-search"></i> BUSCAR
                            </button>

                        </div>
                    </div>
                </div>
            </div>

            <!--SECCION DE PRODUCTOS -->
            <div class="col-sm-9">
                <div id="contenedorProductos" class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">

                    <div class="col mb-5">
                        <div class="card h-100">
                            <!-- Product image-->
                            <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="..." />
                            <!-- Product details-->
                            <div class="card-body p-4">
                                <div class="text-center">
                                    <!-- Product name-->
                                    <h5 class="fw-bolder">Fancy Product</h5>
                                    <!-- Product price-->
                                    $40.00 - $80.00
                                </div>
                            </div>
                            <!-- Product actions-->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">View options</a></div>
                            </div>
                        </div>
                    </div>

                    <div class="col mb-5">
                        <div class="card h-100">
                            <!-- Sale badge-->
                            <div class="badge bg-dark text-white position-absolute" style="top: 0.5rem; right: 0.5rem">Sale</div>
                            <!-- Product image-->
                            <img class="card-img-top" src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg" alt="..." />
                            <!-- Product details-->
                            <div class="card-body p-4">
                                <div class="text-center">
                                    <!-- Product name-->
                                    <h5 class="fw-bolder">Sale Item</h5>
                                    <!-- Product price-->
                                    <span class="text-muted text-decoration-line-through">$50.00</span>
                                    $25.00
                                </div>
                            </div>
                            <!-- Product actions-->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">Add to cart</a></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--PAGINADOR-->
            <nav aria-label="Page navigation example">
                <ul id="paginador" class="pagination justify-content-center">
                    <!-- Aquí se generarán los enlaces de paginación -->
                </ul>
            </nav>
        </div>
    </div>
</section>

@section scripts
{ 
<script>

    var currentPage = 1;  // Página actual
    var pageSize = 8; // Tamaño de la página


        $(document).ready(function () {
          var urlParams = new URLSearchParams(window.location.search);
          var _idCategoria = urlParams.get('categoria') || sessionStorage.getItem("categoria") || 0;
          var _idMarca = urlParams.get('marca') || sessionStorage.getItem("marca") || 0;

          MostrarCategorias();

          // Mostrar los productos filtrados o generales
          MostrarProductos(_idCategoria, _idMarca);

            //MostrarProductos(0, 0);

        })

        //mostrandoCategorias en el card
        function MostrarCategorias() {
            jQuery.ajax({
                url: "@Url.Action("ListaCategorias", "Tienda")",
                type: "GET",
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (response)
                {
                    $("#contenedor_categ").LoadingOverlay("hide");

                    $("<div>").addClass("form-check").append(

                        $("<input>").addClass("form-check-input cursor-pointer").attr({ "type": "radio", "name": "categoria", "value": "0", "id": "cx","checked":"checked"}),
                        $("<label>").addClass("form-check-label").text("Todos").attr({ "for":"cx"})

                    ).appendTo("#contenedor_categ")


                    //recorriendo cada elemento obtenido del response
                    $.each(response.data, function (i, element)
                    {
                        $("<div>").addClass("form-check").append(

                            $("<input>").addClass("form-check-input cursor-pointer").attr({ "type": "radio", "name": "categoria", "value": element.id_Categoria, "id": "c" + i}),
                            $("<label>").addClass("form-check-label").text(element.Descripcion).attr({ "for": "c" + i })

                        ).appendTo("#contenedor_categ")


                    })

                    MostrarMarcas();
                },
                beforeSend: function ()
                {
                    $("#contenedor_categ").LoadingOverlay("show");

                }
            })
        }


        //mostrando Marcas en el card
        function MostrarMarcas()
        {
            //obteniendo el id de la Categoria
             var _idCategoria = $("input[name=categoria]:checked").val();
              jQuery.ajax({
                    url: "@Url.Action("ListaMarcaPorCategoria", "Tienda")",
                    type: "POST",
                    data: JSON.stringify({ idCategoria: _idCategoria }),
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (response)
                    {
                        $("#contenedor_marca").html("");
                        $("#contenedor_marca").LoadingOverlay("hide");


                        $("<div>").addClass("form-check").append(

                            $("<input>").addClass("form-check-input cursor-pointer").attr({ "type": "radio", "name": "marca", "value": "0", "id": "mx", "checked": "checked"}),
                            $("<label>").addClass("form-check-label").text("Todas").attr({ "for":"mx"})

                        ).appendTo("#contenedor_marca")

                        //recorriendo cada elemento obtenido del response
                        $.each(response.data, function (i, element)
                        {
                            $("<div>").addClass("form-check").append(

                                $("<input>").addClass("form-check-input cursor-pointer").attr({ "type": "radio", "name": "marca", "value": element.id_Marca, "id": "m" + i }),
                                $("<label>").addClass("form-check-label").text(element.Descripcion).attr({ "for": "m" + i })

                            ).appendTo("#contenedor_marca")
                        })

                    },
                    beforeSend: function ()
                    {
                        $("#contenedor_marca").LoadingOverlay("show");

                    }
              })
        }


      //mostrando Marcas por categorias filtradas
      $(document).on("change", "input[name=categoria]", function () {
            MostrarMarcas();
      })


  // Método para mostrar los productos con paginación
  function MostrarProductos(_idCategoria, _idMarca, pageNumber = 1) {
       jQuery.ajax({
                  url: "@Url.Action("ListarProductos", "Tienda")",
                  type: "POST",
                  data: JSON.stringify({ idcategoria: _idCategoria, idMarca: _idMarca, pageNumber: pageNumber, pageSize: pageSize }),
                  dataType: "json",
                  contentType: "application/json; charset=utf-8",
            success: function (response) {
                   $("#contenedorProductos").html("");
                   $("#contenedorProductos").LoadingOverlay("hide");

                         $.each(response.data, function (i, element) {
                             $("<div>").addClass("col mb-5").append(
                                 $("<div>").addClass("card h-100").append(
                                     $("<img>").addClass("card-img-top").attr({ "src": "data:image/" + element.Extension + ";base64," + element.Base64 }),
                                     $("<div>").addClass("card-body p-4").append(
                                         $("<div>").addClass("text-center").append(
                                             $("<h5>").addClass("fw-bolder").text(element.Nombre),
                                             "$" + element.Precio.toFixed(2)
                                         )
                                     ),
                                     $("<div>").addClass("card-footer p-2 pt-0 border-top-0 bg-transparent").append(
                                       $("<div>").addClass("d-grid gap-2").append(
                                             @if (Session["UsuarioCliente"] != null) {
                                                 @:$("<button>").addClass("btn btn-success w-100 mt-auto agregarcarrito").data("id_Producto", element.id_Producto).append($("<i>").addClass("fas fa-shopping-cart me-1"), "Add Carrito"),
                                             }
                                             $("<a>").addClass("btn btn-dark w-100 mt-auto")
                                             .attr("href", '@Url.Action("DetalleProducto", "Tienda")' + '?id_Producto=' + element.id_Producto)
                                             .append(
                                              $("<i>").addClass("fas fa-eye me-2"),
                                             "Ver Detalle"
                                              )

                                       )
                                     )
                                 )
                             ).appendTo("#contenedorProductos");
                         });

                         // Mostrar paginación
                         var totalPages = Math.ceil(response.total / pageSize);
                         mostrarPaginador(totalPages, pageNumber);
            },
           beforeSend: function () {
             $("#contenedorProductos").LoadingOverlay("show");
           }
       });
  }

    function mostrarPaginador(totalPages, currentPage) {
        var paginador = $("#paginador");
        paginador.html(""); // Limpiar paginador actual

        if (totalPages > 1) {
            // Botón Anterior
            var prevPageLink = $("<a>").addClass("page-link cursor-pointer btn-lg fs-5").text("Anterior").attr("href", "#");
            if (currentPage === 1) {
                prevPageLink.addClass("disabled");  // Deshabilitar si estamos en la primera página
            } else {
                prevPageLink.on("click", function (e) {
                    e.preventDefault();
                    currentPage--;
                    MostrarProductos($("input[name=categoria]:checked").val(), $("input[name=marca]:checked").val(), currentPage);
                });
            }
            paginador.append($("<li>").addClass("page-item").append(prevPageLink));

            // Páginas numéricas
            for (var i = 1; i <= totalPages; i++) {
                var pageLink = $("<a>").addClass("page-link cursor-pointer btn-lg fs-5").text(i).attr("href", "#");
                var pageItem = $("<li>").addClass("page-item");
                if (i === currentPage) {
                    pageLink.addClass("active");  // Añadir clase 'active' al número actual
                }
                pageLink.on("click", function (e) {
                    e.preventDefault();
                    currentPage = parseInt($(this).text());

                    // Remover la clase 'active' de todos los elementos
                    $(".page-item").removeClass("active");

                    // Añadir la clase 'active' al número de página clickeado
                    $(this).parent().addClass("active");

                    MostrarProductos($("input[name=categoria]:checked").val(), $("input[name=marca]:checked").val(), currentPage);
                });
                pageItem.append(pageLink);
                paginador.append(pageItem);
            }

            // Botón Siguiente
            var nextPageLink = $("<a>").addClass("page-link cursor-pointer btn-lg fs-5").text("Siguiente").attr("href", "#");
            if (currentPage === totalPages) {
                nextPageLink.addClass("disabled");  // Deshabilitar si estamos en la última página
            } else {
                nextPageLink.on("click", function (e) {
                    e.preventDefault();
                    currentPage++;
                    MostrarProductos($("input[name=categoria]:checked").val(), $("input[name=marca]:checked").val(), currentPage);
                });
            }
            paginador.append($("<li>").addClass("page-item").append(nextPageLink));
        }
    }

      $("#btnFiltro").click(function ()
      {
        var _idCategoria = $("input[name=categoria]:checked").val();
        var _idMarca = $("input[name=marca]:checked").val();

        // Guardar los filtros en sessionStorage
        sessionStorage.setItem("categoria", _idCategoria);
        sessionStorage.setItem("marca", _idMarca);

          MostrarProductos(_idCategoria, _idMarca)

          // Restablecer la página actual a 1
          currentPage = 1;
          MostrarProductos(_idCategoria, _idMarca, currentPage);


      })

       $(document).on("click", "button.agregarcarrito", function () {
            jQuery.ajax({
                url: '@Url.Action("AgregarAlCarrito", "Tienda")',
                type: "POST",
                data: JSON.stringify({ idProducto: $(this).data("id_Producto") }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data.respuesta) {
                        MostrarCantidaCarrito();
                        swal({
                            title: "Producto Agregado al Carrito",
                            text: "¿Desea ir al Carrito?",
                            type: "success",
                            showCancelButton: true,
                            confirmButtonClass: "btn-success",
                            cancelButtonClass:"btn-danger",
                            confirmButtonText: "Si",
                            cancelButtonText: "No",
                            closeOnConfirm: true
                        }, function () {
                            window.location.href = '@Url.Action("Carrito","Tienda")'
                        });
                    } else {

                        swal("", data.mensaje, "warning");
                    }
                }
            });
       });
    </script>   
}
