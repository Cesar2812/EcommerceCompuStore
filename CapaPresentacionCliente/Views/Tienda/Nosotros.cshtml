@{
    ViewBag.Title = "Nosotros";
    Layout = "~/Views/Shared/_Layout.cshtml";
} 

<!--HEADER CABEZERA CON ANUNCIO-->
<header class="py-5 bg-black position-relative" style="background-image: url('/Content/images/hábitos-de-emprendedores-con-éxito.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="overlay"></div>
    <div class="container px-5 position-relative z-index-1">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xxl-6">
                <div class="text-center my-5">
                    <h1 class="fw-bolder mb-3" style="color:white">¡Sobre Nosotros!</h1>
                    <p class="lead fw-normal mb-4" style="color: #d3d3d3;">Nuestra Filosofia.</p>
                </div>
            </div>
        </div>
    </div>
</header>


<!-- Seccion de Mision y Vision -->
<section class="py-3 py-md-5 py-xl-8">
    <div class="container overflow-hidden">
        <div class="row gy-4 gy-lg-0">

            <!-- Tarjeta Mision -->
            <div class="col-12 col-lg-4 d-flex">
                <article>
                    <div class="card border-0 d-flex flex-column" style="height: 100%;">
                        <img class="card-img-top img-fluid m-0" loading="lazy" src="~/Content/images/vision-mision-y-valores-2.jpeg" alt="Our Approach">
                        <div class="card-body border  p-4 d-flex flex-column">
                            <div class="entry-header mb-3">
                                <h2 class="card-title entry-title h4 mb-0">
                                    <a class="link-dark text-decoration-none" href="#!">Mision</a>
                                </h2>
                            </div>
                            <p class="card-text entry-summary text-secondary mb-3 flex-grow-1">Nuestra misión es proveer dispositivos electrónicos en Granada, ofreciendo a nuestros clientes una experiencia de compra excepcional, donde la calidad, la innovación y el servicio personalizado se combinen para satisfacer las necesidades tecnológicas del presente. Nos esforzamos por brindar un catálogo diverso de productos de alta tecnología, respaldado por un equipo capacitado y siempre dispuesto a ofrecer asesoramiento y soluciones a medida.</p>
                        </div>
                    </div>
                </article>
            </div>

            <!-- Tarjeta Vision -->
            <div class="col-12 col-lg-4 d-flex">
                <article>
                    <div class="card border-0 d-flex flex-column" style="min-height: 100%;">
                        <img class="card-img-top img-fluid m-0" loading="lazy" src="~/Content/images/hombre-negocios-gran-oficina_53876-144319.jpg" alt="Our Vision">
                        <div class="card-body border p-4">
                            <div class="entry-header mb-3">
                                <h2 class="card-title entry-title h4 mb-0">
                                    <a class="link-dark text-decoration-none" href="#!">Vision</a>
                                </h2>
                            </div>
                            <p class="card-text entry-summary text-secondary mb-3">Ser reconocidos en Granada y sus alrededores como la tienda de referencia para la compra de dispositivos electrónicos de última generación, donde la innovación y el servicio al cliente es fundamental. Aspiramos a crecer como un negocio comprometido con el desarrollo tecnológico de la región, mientras ampliamos nuestra presencia y alcance en el mercado nacional.</p>
                        </div>
                    </div>
                </article>
            </div>

            <!-- Tarjeta Valores -->
            <div class="col-12 col-lg-4 d-flex">
                <article>
                    <div class="card border-0 d-flex flex-column" style="min-height: 100%;">
                        <img class="card-img-top img-fluid m-0" loading="lazy" src="~/Content/images/valores-corporativos-de-una-empresa.jpg" alt="Our Approach">
                        <div class="card-body border p-4">
                            <div class="entry-header mb-3">
                                <h2 class="card-title entry-title h4 mb-0">
                                    <a class="link-dark text-decoration-none" href="#!">Valores</a>
                                </h2>
                            </div>

                            <ul class="text-secondary entry-summary mb-3">
                                <li>
                                    Innovación
                                </li>
                                <li>
                                    Calidad
                                </li>
                                <li>
                                    Confiabilidad
                                </li>
                                <li>
                                    Servicio al cliente excepcional
                                </li>
                                <li>
                                    Honestidad
                                </li>
                            </ul>
                        </div>
                    </div>
                </article>
            </div>

        </div>
    </div>
</section> 

