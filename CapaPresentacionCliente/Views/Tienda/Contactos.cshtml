@{
    ViewBag.Title = "Contactos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/Content/Estilo.css" rel="stylesheet" />

    <style>

        header.bg-black {
            position: relative;
            min-height: 300px;
            opacity: 0;
            transition: opacity 1s ease-out; /* Transición de opacidad */
        }

            header.bg-black.visible {
                opacity: 1;
            }
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
        }
    </style>
</head>

<!--HEADER CABEZERA CON ANUNCIO-->
 <header class="py-5 bg-black position-relative" style="background-image: url('/Content/images/smartphone-mobile-computer.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
    <div class="overlay"></div>
    <div class="container px-5 position-relative z-index-1">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xxl-6">
                <div class="text-center my-5">
                    <h1 class="fw-bolder mb-3" style="color:white">¡Contactos!</h1>
                    <p class="lead fw-normal mb-4" style="color: #d3d3d3;">Visita Nuestro Catalogo de Productos.</p>
                    <!-- Botón con nuevo color -->
                    <a class="btn btn-lg" style="background-color: rgb(0, 65, 93); color: white;" href="@Url.Action("Index", "Tienda")">Visitar Catalogo</a>
                </div>
            </div>
        </div>
    </div>
</header>


<!-- Page content -->
<section class="py-5">
    <div class="container px-5">
        <div class="row gx-5 align-items-center">
            <!-- Contact form -->
            <div class="col-lg-6">
                <div class="bg-light rounded-3 py-5 px-4 px-md-5">
                    <div class="text-center mb-5">

                        <h1 class="fw-bolder">Contáctanos</h1>
                        <p class="lead fw-normal text-muted mb-0">Envíanos un correo para contactarnos</p>
                    </div>

                    <form id="contactForm">
                        <div class="form-floating mb-3">
                            <input class="form-control" id="name" type="text" placeholder="Nombre Completo..." required />
                            <label for="name">Nombre Completo...</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control" id="email" type="email" placeholder="name@example.com" required />
                            <label for="email">Correo...</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control" id="phone" type="tel" placeholder="(123) 456-7890" required />
                            <label for="phone">Número de Teléfono...</label>
                        </div>
                        <div class="form-floating mb-3">
                            <textarea class="form-control" id="message" placeholder="Mensaje" style="height: 10rem" required></textarea>
                            <label for="message">Mensaje</label>
                        </div>
                        <div class="d-grid">
                            <button class="btn btn-primary btn-lg" style="cursor: pointer; background-color: #00415d;" id="submitButton" type="submit">Enviar</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Contact cards -->
            <div class="col-lg-6">
                <div class="row gx-5 row-cols-1 gy-4">
                    <div class="col">
                        <div class="feature bg-black rounded-3 mb-3">
                            <i class="bi bi-envelope text-white"></i>
                        </div>
                        <div class="h5">Correo</div>
                        <p class="text-muted mb-0">contacto@ejemplo.com</p>
                    </div>
                    <div class="col">
                        <div class="feature bg-black rounded-3 mb-3">
                            <i class="bi bi-telephone text-white"></i>
                        </div>
                        <div class="h5">WhatsApp</div>
                        <p class="text-muted mb-0">
                            <a href="https://wa.me/+50578216684" target="_blank" class="text-decoration-none" style="color:black">Envíanos un mensaje</a>
                        </p>
                    </div>
                    <div class="col">
                        <div class="feature bg-black rounded-3 mb-3">
                            <i class="bi bi-geo-alt text-white"></i>
                        </div>
                        <div class="h5">Dirección</div>
                        <p class="text-muted mb-0">Calle Ejemplo #123, Ciudad, País</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section> 

<script>
    // Cuando se cargue la página, se agrega la clase 'visible' para activar la transición
    window.addEventListener('DOMContentLoaded', (event) => {
        document.querySelector('header.bg-black').classList.add('visible');
    });
</script>