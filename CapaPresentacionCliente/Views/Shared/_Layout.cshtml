    <style>
        /*ESTILOS DEL FOOTER*/
        .dropdown-item:focus,
        .dropdown-item:active {
            background-color: transparent !important;
            color: inherit !important;
            outline: none !important;
            box-shadow: none !important;
        }

        .dropdown-item.clicked {
            color: black !important;
            font-weight: bold;
        }

        body {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease-in-out;
        }

        .dark-mode body {
            background-color: #1f1f1f !important;
            color: #e0e0e0 !important;
        }

        /* NAVBAR */
        .dark-mode .navbar-light {
            background-color: #1f1f1f !important;
        }

            .dark-mode .navbar-light .navbar-nav .nav-link,
            .dark-mode .navbar-light .navbar-brand,
            .dark-mode .navbar-light .navbar-toggler-icon {
                color: #ffffff !important;
            }

                .dark-mode .navbar-light .navbar-nav .nav-link.active {
                    font-weight: bold;
                    color: #ffffff !important;
                }

        /* CARD y textos */
        .dark-mode .card,
        .dark-mode .form-control,
        .dark-mode .dropdown-menu {
            background-color: #2a2a2a !important;
            color: #e0e0e0 !important;
        }

            .dark-mode .dropdown-menu .dropdown-item {
                color: #ffffff !important;
            }

        /* BG light general */
        .bg-light {
            background-color: #f8f9fa !important;
            color: #212529;
        }

        .dark-mode .bg-light {
            background-color: #1e1e1e !important;
            color: #e0e0e0 !important;
        }

        /* Botones */
        .dark-mode a.btn.btn-outline-dark,
        .dark-mode button.btn.btn-outline-dark {
            color: #fff !important;
            border-color: #fff !important;
            background-color: transparent !important;
            transition: box-shadow 0.3s ease;
        }

            .dark-mode a.btn.btn-outline-dark:hover,
            .dark-mode button.btn.btn-outline-dark:hover,
            .dark-mode a.btn.btn-outline-dark:focus,
            .dark-mode button.btn.btn-outline-dark:focus {
                background-color: transparent !important;
                box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
                color: #fff !important;
                border-color: #fff !important;
            }

        /* Tablas */
        .dark-mode table.table,
        .dark-mode table.table thead tr,
        .dark-mode table.table tbody tr,
        .dark-mode table.table tbody td,
        .dark-mode table.table thead th {
            background-color: #2a2a2a !important;
            color: #e0e0e0 !important;
            border-color: #444 !important;
        }

        /* Cartas Nosotros */
        .dark-mode .card .card-title,
        .dark-mode .card .card-text,
        .dark-mode .card li,
        .dark-mode .card a {
            color: #ffffff !important;
        }

        /* Acordeón */
        .dark-mode .accordion-item,
        .dark-mode .accordion-body,
        .dark-mode .accordion-button {
            background-color: #2a2a2a !important;
            color: #ffffff !important;
            border-color: #444 !important;
        }

            .dark-mode .accordion-button:not(.collapsed) {
                background-color: #3a3a3a !important;
                color: #ffffff !important;
                box-shadow: none;
            }





        /* Estilos personalizados para el navbar */
        .nav-custom,
        .nav-custom.active{
            font-size: 22px;
            font-weight: 450;
            color: black !important;
            transition: all 0.3s ease;
            position: relative;
        }

            .nav-custom i {
                font-size: 1.4rem;
                color: black;
                transition: transform 0.3s ease;
            }

            .nav-custom:hover {
                color: #08497a !important;
            }

                .nav-custom:hover::after {
                    content: "";
                    position: absolute;
                    width: 100%;
                    height: 2px;
                    background-color: #0a4275;
                    bottom: -5px;
                    left: 0;
                    transition: width 0.3s ease;
                }

                .nav-custom:hover i {
                    transform: scale(1.15);
                }



           








       
        
    </style>
