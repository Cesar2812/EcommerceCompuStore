    <script>

        $(document).ready(function () {

            const toggleButton = document.getElementById('toggleTheme');
            const icon = document.getElementById('themeIcon')||null;
            const body = document.body;

            function applyTheme(theme) {
                if (theme === "dark") {
                    body.classList.add("dark-mode");
                    if (icon) {
                        icon.classList.remove("fa-moon");
                        icon.classList.add("fa-sun");
                    }
                } else {
                    body.classList.remove("dark-mode");
                    if (icon) {
                        icon.classList.remove("fa-sun");
                        icon.classList.add("fa-moon");
                    }
                }
            }


            const storedTheme = localStorage.getItem("theme") || "light";
            applyTheme(storedTheme);
           

            // Si el botón existe (está logueado), permitir el cambio de tema
            if (toggleButton && icon) {
                toggleButton.addEventListener("click", function () {
                    const newTheme = body.classList.contains("dark-mode") ? "light" : "dark";
                    localStorage.setItem("theme", newTheme);
                    applyTheme(newTheme);
                });
            }
            MostrarCantidaCarrito();
        })

        //metodo para cerrar sesion
        function confirmLogout() {
            Swal.fire({
                position: "top-end",
                title: '¿Estas seguro que desea cerrar sesión?',
                icon: 'warning',
                width: '400px',

                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí',
                cancelButtonText: 'No',
                customClass: {
                    popup: 'swal-border'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    //localStorage.removeItem('theme'); // elimina la cookie para que al cerrar vuelva al modo claro
                    window.location.href = '/Acceso/CerrarSesion';
                }
            });
        }


        //funcion para mostrar la cantidad de productos en el carrito del cliente
        function MostrarCantidaCarrito()
        {
            if ($("#cantidadCarro").length > 0)
            {
                jQuery.ajax({
                    url: '@Url.Action("CantidadEnCarrito", "Tienda")',
                    type: "GET",
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data)
                    {
                        $("#cantidadCarro").text(data.cantidad)

                    }

                });

            }

        }

        //alert de bienvenida al cliente
      document.addEventListener("DOMContentLoaded", function() {
        // Verificar si existe un mensaje en TempData para mostrar la alerta
        @if (TempData["ClienteNombre"] != null)
         {
            <text>
            Swal.fire({
                position: "top-end",
                title: '¡Bienvenido a la Tienda CompuStore! @TempData["ClienteNombre"]',
                icon: 'success',
                customClass: {
                    popup: 'swal-border'
                },
                timer: 2000,
                showConfirmButton: false
            });
            </text>
         }
      });

      document.getElementById("misCompras").addEventListener("click", function () {
          this.classList.add("clicked");
      });

    </script>
