@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Tienda CompuStore</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>

        body {
            background-image: url('../Content/images/1500x844-tiendas-virtuales.jpg');
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }

        .card {
            background-color: rgba(255, 255, 255, 0.5);
        }

        .card-header {
            background-color: rgba(255, 255, 255, 0.5);
            color: #000000;
        }

        .card-footer {
            background-color: rgba(255, 255, 255, 0.5);
        }

            .card-footer a {
                color: #000000;
            }


        .custom-control-label {
            color: #000000;
        }

        .custom-alert {
            width: 350px;
            padding: 10px;
            box-shadow: none;
            border-radius: 8px;
        }

    </style>
</head>
<body>
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-5">
                            <div class="card shadow-lg border-0 rounded-lg mt-5">

                                <div class="card-header"><h3 class="text-center font-weight-light my-8"> BIENVENIDO </h3></div>
                                <div class="card-body">


                                    <form class="user" action="@Url.Action("Index","Acceso")" method="post">
                                        <div class="form-group">
                                            <input type="email" class="form-control form-control-user"
                                                   name="correo" aria-describedby="emailHelp"
                                                   placeholder="Email Address..." autocomplete="off">
                                        </div>
                                        <div class="form-group">
                                            <input type="password" class="form-control form-control-user"
                                                   name="clave" placeholder="Password" autocomplete="off">
                                        </div>
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox small">
                                                <input type="checkbox" class="custom-control-input" id="customCheck">
                                                <label class="custom-control-label" for="customCheck">
                                                    Recuerdame
                                                </label>
                                            </div>
                                        </div>
                                        <button class="btn btn-primary btn-user btn-block" type="submit">
                                            Entrar a la Tienda
                                        </button>
                                    </form>


                                </div>

                                <hr>
                                <div class="card-footer text-center py-3">
                                    <div class="small"><a href="@Url.Action("RegistrarCliente","Acceso")"> ¿No tienes una cuenta? Cree una!! </a></div>
                                    <a class="small" href="@Url.Action("RestablecerClaveCliente","Acceso")"> ¿Olvido Su Contraseña? </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="~/Scripts/bootstrap.bundle.js"></script>
    <script>

    @if (ViewBag.Error != null)
     {
            <text>
                 Swal.fire({
                 position: "top-end",
                 icon: "error",
                 title: "@ViewBag.Error",
                 showConfirmButton: false,
                 timer: 1000,
                customClass:
                {
                  popup: 'custom-alert'
                }
                 });
            </text>
     }

    </script>
</body>
</html>
