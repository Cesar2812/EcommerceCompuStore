@model CapaEntidad.Cliente

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Creacion De Cuenta</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @Styles.Render("~/Content/css")

    <style>
        body {
            padding-top: 50px;
            background-color: none;
        }

        .container {
            margin-bottom: 50px;
        }

        .panel-login {
            background-color: whitesmoke;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0px 2px 3px 0px rgba(0.5,0.5,0.5,0.5);
        }

        .panel-heading {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            font-weight: bold;
            color: #00415d;
            margin-bottom: 20px;
        }

            .panel-heading img {
                max-width: 150px;
                margin-right: 20px;
            }

        .panel-body .form-group input {
            height: 45px;
            border: 1px solid #ddd;
            font-size: 16px;
        }

        .btn-login {
            background-color: #00415d;
            color: #fff;
            font-size: 16px;
            padding: 10px;
            width: 100%;
            border: none;
            border-radius: 5px;
        }

            .btn-login:hover {
                background-color: #00415d;
                color: white;
            }

        .btn-register {
            background-color: #1CB94E;
            color: #fff;
            font-size: 16px;
            padding: 10px;
            width: 100%;
            border: none;
            border-radius: 5px;
        }

            .btn-register:hover {
                background-color: #1CA347;
            }

        .custom-alert {
            width: 350px;
            padding: 10px;
            box-shadow: none;
            border-radius: 8px;
        }

        .form-group.remember {
            display: flex;
            align-items: center;
        }

            .form-group.remember label {
                margin-left: 10px;
                font-size: 16px;
            }

        .password-container {
            display: flex;
            align-items: center;
            position: relative;
        }

            .password-container input {
                width: 100%;
                padding-right: 40px;
            }

            .password-container .toggle-password {
                position: absolute;
                right: 10px;
                cursor: pointer;
                color: #00415d;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="panel panel-login">

                    <div class="panel-heading">
                        <img src="../Content/images/logo.png" alt="Logo">
                        <span> REGISTRESE </span>
                    </div>

                    <div class="panel-body">
                        <form class="user" action="@Url.Action("RegistrarCliente","Acceso")" method="post">

                            <div class="form-group row">

                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control form-control-user", @id = "txtNombre", @placeholder = "Nombre", @autocomplete = "off", value = ViewData["Nombre"] })
                                </div>

                                <div class="col-sm-6">

                                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control form-control-user", @id = "txtApellido", @placeholder = "Apellido", @autocomplete = "off", value = ViewData["Apellido"] })
                                </div>
                            </div>

                            <div class="form-group">

                                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control form-control-user", @id = "txtCorreo", @placeholder = "Correo Electronico", @autocomplete = "off", value = ViewData["Correo"] })

                            </div>

                            <div class="form-group row">

                                <div class="col-sm-6 mb-3 mb-sm-0 position-relative">
                                    <div class="input-group">
                                        @Html.PasswordFor(m => m.Clave, new { @class = "form-control form-control-user", @id = "txtClave", @placeholder = "Contraseña", @autocomplete = "off" })
                                        <div class="input-group-append">
                                            <span class="input-group-text" onclick="togglePassword()" style="cursor: pointer;">
                                                <i class="fas fa-eye" id="toggleIcon"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6 mb-3 mb-sm-0 position-relative">
                                    <div class="input-group">
                                        @Html.PasswordFor(m => m.ConfirmarClave, new { @class = "form-control form-control-user", @id = "txtConfirmarClave", @placeholder = "Contraseña", @autocomplete = "off" })
                                        <div class="input-group-append">
                                            <span class="input-group-text" onclick="togglePassword2()" style="cursor: pointer;">
                                                <i class="fas fa-eye" id="toggleIcon2"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div> 


                            </div>

                            <button class="btn btn-login" type="submit">Crear Cuenta</button>
                        </form>

                        <div class="panel-footer text-center">
                            <a href="@Url.Action("Index","Acceso")"> ¡Regrese Al Login!</a><br>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--INICIO DEL FOOTER-->
    <footer class="text-center text-lg-start text-white"
            style="background-color: black">
        <!-- SECCION REDES SOCIALES -->
        <section class="d-flex justify-content-between p-4"
                 style="background-color: black">
            <!--TEXTO DE LA IZQUIERDA-->
            <div class="me-5">
                <span style="color: white;">ENCUENTRANOS EN NUESTRAS REDES SOCIALES:</span>
            </div>
            <!-- FIN DEL TEXTO DE LA IZQUIERDA-->
            <!--ICONOS DE LA DERECHA-->
            <div>
                <a href="https://www.facebook.com/profile.php?id=100064135029316&sk" class="text-white me-4" target="_blank">
                    <i class="fab fa-facebook-f"></i>
                </a>

                <a href="https://www.instagram.com/compustore?igsh=dWdmMXMxaDc4amwy" class="text-white me-4" target="_blank">
                    <i class="fab fa-instagram"></i>
                </a>

                <a href="" class="text-white me-4">
                    <i class="fab fa-twitter"></i>
                </a>

            </div>
            <!--FIN DE ICONOS DE LA DERECHA-->
        </section>
        <!--FINAL DE LA SECCION DE REDES SOCIALES-->
        <!--SECCION DE LINKS Y LOGO-->
        <section class="">
            <div class="container text-center text-md-start mt-5">
                <!-- GRID FILA-->
                <div class="row mt-3">
                    <!--GID COLUMNA-->

                    <div class="col-md-3 col-lg-4 col-xl-3 mx-auto mb-4">
                        <!--CONTENIDO-->
                        <img src="~/Content/images/LOGO.png" alt="Company Logo" style="height: 60px; width: 160px;">
                        <hr class="mb-4 mt-0 d-inline-block mx-auto"
                            style="width: 60px; background-color: white; height: 2px" />
                        <p>
                            Somos CompuStore la tienda lider en la Ciudad de Granada
                            ofreciendoles todo tipo de productos tecnologicos y soporte a
                            sus Equipos

                        </p>
                    </div>


                    <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!--REDIRRECION A LOS CONTROLADORES-->
                        <h6 class="text-uppercase fw-bold">NUESTRO SITIO</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto"
                            style="width: 60px; background-color: white; height: 2px" />
                        <p>
                            <a href="@Url.Action("Inicio","Tienda")" class="text-white">Inicio</a>
                        </p>
                        <p>
                            <a href="@Url.Action("Nosotros","Tienda")" class="text-white">Nosotros</a>
                        </p>
                        <p>
                            <a href="@Url.Action("Servicios","Tienda")" class="text-white">Servicios</a>
                        </p>
                        <p>
                            <a href="@Url.Action("Index","Tienda")" class="text-white">Catalogo</a>
                        </p>
                        <p>
                            <a href="@Url.Action("Contactos","Tienda")" class="text-white">Contacto</a>
                        </p>
                    </div>


                    <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mb-4">
                        <!--REDIRECCION AL INICIO DE SESION Y CRACION DE CUENTAS Y PAYPAL-->
                        <h6 class="text-uppercase fw-bold">PARA TI</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto"
                            style="width: 60px; background-color: white; height: 2px" />
                        <p>
                            <a href="@Url.Action("RegistrarCliente","Acceso")" class="text-white">Crear Cuenta</a>
                        </p>
                        <p>
                            <a href="@Url.Action("RestablecerClaveCliente","Acceso")" class="text-white">Recuperar Contraseña</a>
                        </p>
                        <p>
                            <a href="https://www.sandbox.paypal.com/signin" class="text-white" target="_blank">Revisar Cuenta PayPal</a>
                        </p>

                    </div>

                    <!--SECCION DE CONTACTOS-->
                    <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mb-md-0 mb-4">

                        <h6 class="text-uppercase fw-bold">CONTACTANOS</h6>
                        <hr class="mb-4 mt-0 d-inline-block mx-auto"
                            style="width: 60px; background-color: white; height: 2px" />
                        <p style="display: flex; align-items: center;"><i class="fas fa-home mr-3"></i> Granada,Calle Real Xalteva,Frente a Farmacia Praga</p>
                        <p style="display: flex; align-items: center;"><i class="fas fa-envelope mr-3"></i> compuStoregranada@gmail.com</p>
                        <p style="display: flex; align-items: center;"><i class="fas fa-phone mr-3"></i> +505 78216684</p>

                    </div>
                    <!--FINAL DE LAS COLUMNAS-->
                </div>
                <!-- Grid row -->
            </div>
        </section>

        <!--SECCION DEL COPYRIGTH-->
        <div class="text-center p-3"
             style="background-color: rgba(0, 0, 0, 0.2)">
            © 2025 Copyright:
            <a class="text-white" href="https://mdbootstrap.com/">  compuStoreGranada@gmail.com</a>
        </div>
        <!--FIN DEL COPYRIGHT-->
    </footer>
    <!--FIN DEL FOOTER -->

    <script src="~/Scripts/bootstrap.bundle.js"></script>

    <script>

        //funcion que muestra la clave con el icono de font para el txt de clave
        function togglePassword() {
            var passwordField = document.getElementById("txtClave");
            var toggleIcon = document.getElementById("toggleIcon");

            if (passwordField.type === "password") {
                passwordField.type = "text";
                toggleIcon.classList.remove("fa-eye");
                toggleIcon.classList.add("fa-eye-slash");
            } else {
                passwordField.type = "password";
                toggleIcon.classList.remove("fa-eye-slash");
                toggleIcon.classList.add("fa-eye");
            }
        }

        //funcion que muestra la clave para el icono del txtConfirmarClave
        function togglePassword2() {
            var passwordField = document.getElementById("txtConfirmarClave");
            var toggleIcon = document.getElementById("toggleIcon2");

            if (passwordField.type === "password") {
                passwordField.type = "text";
                toggleIcon.classList.remove("fa-eye");
                toggleIcon.classList.add("fa-eye-slash");
            } else {
                passwordField.type = "password";
                toggleIcon.classList.remove("fa-eye-slash");
                toggleIcon.classList.add("fa-eye");
            }
        }

        //alert que se muestra si hay algun campo vacio
         @if (ViewBag.Error != null)
          {
               <text>
                 Swal.fire({
                 position: "top-end",
                 icon: "error",
                 title: "@ViewBag.Error",
                 showConfirmButton: false,
                 timer: 1000,
                customClass:
                 {
                  popup: 'custom-alert'
                 }
                 });
                </text>
          }


        //alert que se va a ejecutar cuando se creer la cuenta de forma exitosa redireccionar al fromulario de logueo
       @if (TempData["SuccessMessage"] != null)
        {
         <text>
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: "Cuenta Creada Exitosamente",
                showConfirmButton: false,
                timer: 1500,
                customClass: {
                    popup: 'custom-alert'
                }
            }).then((result) => {
                window.location = '@Url.Action("Index", "Acceso")';
            });
            </text>
        }
    </script>
</body>
</html>

